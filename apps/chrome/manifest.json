{
  "manifest_version": 3,
  "name": "Scholia — Select & Explain",
  "short_name": "Scholia",
  "version": "0.2.2",
  "description": "Select text, precise math, or a screen region and get a contextual AI explanation.",
  "homepage_url": "https://github.com/heaps0rt/scholia",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "offscreen",
    "clipboardWrite",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Scholia menu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "explain-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Explain the current selection"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture and explain a screen region"
    },
    "quick-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Scholia Quick Chat in the sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-probe.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*",
        "vendor/pdfjs/pdf.min.mjs",
        "vendor/pdfjs/pdf.worker.min.mjs",
        "vendor/pdfjs/cmaps/*",
        "vendor/pdfjs/standard_fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
