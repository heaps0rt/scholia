{
  "manifest_version": 3,
  "name": "Scholia — Select & Explain",
  "short_name": "Scholia",
  "version": "0.1.0",
  "description": "Select text, precise math, or a screen region and get a contextual AI explanation.",
  "homepage_url": "https://github.com/heaps0rt/scholia",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Scholia",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "explain-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Explain the current selection"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture and explain a screen region"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
