# Terminate HTTPS at your reverse proxy and preserve the original Host header.
SCHOLIA_ORIGIN=https://scholia.example.com
SCHOLIA_DATA_DIR=/data
SCHOLIA_CANVAS_HOSTS=canvas.ntnu.no
HOST=0.0.0.0
PORT=3000
# Optional: a 64-character hexadecimal encryption key supplied by a secret manager.
# Otherwise an encryption.key file is created in SCHOLIA_DATA_DIR. Back it up with the database.

# Optional local OCR settings. The Docker image includes English and Norwegian.
# SCHOLIA_OCR=off
# SCHOLIA_OCR_LANGUAGES=eng+nor
# SCHOLIA_TESSERACT=/usr/bin/tesseract
